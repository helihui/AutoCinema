<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AutoCinema.Desktop.ViewModels"
        x:Class="AutoCinema.Desktop.Views.StoryboardReviewWindow"
        x:DataType="vm:StoryboardReviewViewModel"
        Title="剧本审阅 · CoDesign"
        Width="900" MinHeight="600" MaxHeight="900"
        WindowStartupLocation="CenterScreen"
        Background="#0d0d14">

    <Grid RowDefinitions="Auto, *, Auto">
        <!-- ── 顶部标题区 ── -->
        <Border Grid.Row="0" Background="#1a1a2e" Padding="24,14">
            <Grid ColumnDefinitions="*, Auto">
                <StackPanel>
                    <TextBlock Text="🎬 剧本审阅" FontSize="13" Foreground="#8888aa" Margin="0,0,0,2"/>
                    <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="Bold" Foreground="White"/>
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="6">
                    <TextBlock Text="{Binding Shots.Count, StringFormat='共 {0} 个分镜'}"
                               Foreground="#ffb347" FontSize="13" HorizontalAlignment="Right"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ── 主体内容 ── -->
        <ScrollViewer Grid.Row="1" Background="#0d0d14">
            <StackPanel Margin="24,16" Spacing="20">

                <!-- 梗概 -->
                <Border Background="#14142a" CornerRadius="10" Padding="16">
                    <StackPanel Spacing="8">
                        <TextBlock Text="📖 故事梗概" Foreground="#8888bb" FontSize="12" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding Synopsis}" Foreground="#d0d0e8" TextWrapping="Wrap" FontSize="13"/>
                        <TextBlock Text="{Binding WrappingStyle, StringFormat='🎨 包装风格：{0}'}"
                                   Foreground="#7a7aaa" FontSize="12" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- 角色 / 场景设定（横排两栏）-->
                <Grid ColumnDefinitions="*, 16, *">
                    <!-- 角色设定 -->
                    <Border Background="#14142a" CornerRadius="10" Padding="16">
                        <StackPanel Spacing="6">
                            <TextBlock Text="👤 角色设定" Foreground="#8888bb" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <ItemsControl ItemsSource="{Binding CharacterSummaries}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" Foreground="#d0d0e8" FontSize="12"
                                                   TextWrapping="Wrap" Margin="0,0,0,4"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                    <!-- 场景设定 -->
                    <Border Grid.Column="2" Background="#14142a" CornerRadius="10" Padding="16">
                        <StackPanel Spacing="6">
                            <TextBlock Text="🌄 场景设定" Foreground="#8888bb" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <ItemsControl ItemsSource="{Binding SceneSummaries}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" Foreground="#d0d0e8" FontSize="12"
                                                   TextWrapping="Wrap" Margin="0,0,0,4"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- 分镜列表（高度随内容自适应）-->
                <StackPanel Spacing="0">
                    <TextBlock Text="🎥 分镜详情（可直接编辑旁白和配图描述）"
                               Foreground="#8888bb" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,10"/>
                    <ItemsControl ItemsSource="{Binding Shots}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ShotEditItem">
                                <Border Background="#1a1a30" CornerRadius="10" Margin="0,0,0,10" Padding="16">
                                    <Grid RowDefinitions="Auto, 12, Auto, 8, Auto">
                                        <!-- 分镜标题 -->
                                        <Grid Grid.Row="0" ColumnDefinitions="Auto, *, Auto">
                                            <Border Background="#2a2a5a" CornerRadius="6" Padding="8,4">
                                                <TextBlock Text="{Binding DisplayTitle}"
                                                           Foreground="#a0a0ff" FontSize="12" FontWeight="SemiBold"/>
                                            </Border>
                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding Transition, StringFormat='转场: {0}'}"
                                                       Foreground="#666688" FontSize="11"
                                                       VerticalAlignment="Center"/>
                                        </Grid>

                                        <!-- 旁白（可编辑）-->
                                        <StackPanel Grid.Row="2" Spacing="4">
                                            <TextBlock Text="旁白" Foreground="#7777aa" FontSize="11"/>
                                            <TextBox Text="{Binding NarrationText, Mode=TwoWay}"
                                                     Background="#0a0a1e"
                                                     Foreground="#e0e0ff"
                                                     BorderBrush="#333366"
                                                     FontSize="13"
                                                     TextWrapping="Wrap"
                                                     AcceptsReturn="True"
                                                     MinHeight="48"
                                                     Padding="8,6"
                                                     CornerRadius="6"/>
                                        </StackPanel>

                                        <!-- 配图描述（可编辑）-->
                                        <StackPanel Grid.Row="4" Spacing="4">
                                            <TextBlock Text="AIGC 配图描述" Foreground="#7777aa" FontSize="11"/>
                                            <TextBox Text="{Binding AigcPrompt, Mode=TwoWay}"
                                                     Background="#0a0a1e"
                                                     Foreground="#aaaacc"
                                                     BorderBrush="#333355"
                                                     FontSize="12"
                                                     TextWrapping="Wrap"
                                                     AcceptsReturn="True"
                                                     MinHeight="36"
                                                     Padding="8,6"
                                                     CornerRadius="6"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- 制片说明 -->
                <Border Background="#14142a" CornerRadius="10" Padding="16"
                        IsVisible="{Binding Notes, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                    <StackPanel Spacing="6">
                        <TextBlock Text="📝 制片说明" Foreground="#8888bb" FontSize="12" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding Notes}" Foreground="#aaaacc" TextWrapping="Wrap" FontSize="12"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- ── 底部操作栏 ── -->
        <Border Grid.Row="2" Background="#1a1a2e" Padding="24,12">
            <Grid ColumnDefinitions="*, Auto">
                <TextBlock Text="✏️ 可直接修改上方旁白和配图描述，确认后继续生成视频"
                           Foreground="#666688" FontSize="12" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12">
                    <Button Command="{Binding CancelCommand}"
                            Background="#2a2a44" Foreground="#aaaacc"
                            Padding="16,8" CornerRadius="8"
                            Content="✖ 取消"/>
                    <Button Command="{Binding ConfirmAndGenerateCommand}"
                            Background="#6a3de8" Foreground="White"
                            Padding="20,8" CornerRadius="8"
                            FontWeight="SemiBold"
                            Content="确认生成 ▶"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
