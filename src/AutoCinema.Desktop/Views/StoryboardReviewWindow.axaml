<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:AutoCinema.Desktop.ViewModels"
        xmlns:avaloniaEdit="https://github.com/avaloniaui/avaloniaedit"
        x:Class="AutoCinema.Desktop.Views.StoryboardReviewWindow"
        x:DataType="vm:StoryboardReviewViewModel"
        Title="{Binding WindowTitle}"
        Width="1000" Height="700"
        WindowStartupLocation="CenterOwner"
        Background="#1e1e1e">

    <Design.DataContext>
        <vm:StoryboardReviewViewModel/>
    </Design.DataContext>

    <Grid RowDefinitions="Auto, *, Auto">
        <!-- Header -->
        <Border Grid.Row="0" Background="#252526" Padding="20,10" Height="60">
            <StackPanel Orientation="Horizontal" Spacing="15" VerticalAlignment="Center">
                <TextBlock Text="🎬" FontSize="20" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding WindowTitle}" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="White"/>
            </StackPanel>
        </Border>

        <!-- Main Content Editor -->
        <Border Grid.Row="1" Margin="10" Background="#1e1e1e" BorderBrush="#333" BorderThickness="1">
            <TextBox Name="JsonEditor"
                     AcceptsReturn="True"
                     AcceptsTab="True"
                     TextWrapping="NoWrap"
                     FontFamily="Consolas, Courier New, monospace"
                     Foreground="#d4d4d4"
                     Background="#1e1e1e"
                     CaretBrush="#d4d4d4"
                     BorderThickness="0"
                     FontSize="14"
                     Text="{Binding ScreenplayJsonText, Mode=TwoWay}"
                     IsReadOnly="{Binding IsReadOnly}" />
        </Border>

        <!-- Footer / Action bar -->
        <Border Grid.Row="2" Background="#252526" Padding="15,10">
            <Grid ColumnDefinitions="*, Auto">
                <TextBlock Text="{Binding StatusMessage}" Foreground="White" VerticalAlignment="Center"/>
                
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                    <Button Content="关闭" Command="{Binding CancelCommand}" 
                            Background="#333" Foreground="White" Padding="25,8" CornerRadius="4"/>
                    
                    <!-- 普通保存 -->
                    <Button Content="💾 保存更改" Command="{Binding SaveCommand}" 
                            IsVisible="{Binding !CanContinuePipeline}"
                            Background="#007ACC" Foreground="White" Padding="25,8" CornerRadius="4"/>
                    
                    <!-- 若处于待审核任务则显示放行 -->
                    <Button Content="✅ 确认并继续生成" Command="{Binding SaveAndContinueCommand}" 
                            IsVisible="{Binding CanContinuePipeline}"
                            Background="#2da44e" Foreground="White" Padding="25,8" CornerRadius="4" FontWeight="Bold"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
