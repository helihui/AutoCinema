<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:AutoCinema.Desktop.ViewModels.JobCreation"
        xmlns:controls="using:AutoCinema.Desktop.Views.Controls"
        mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="700"
        x:Class="AutoCinema.Desktop.Views.JobCreationWindow"
        x:DataType="vm:JobCreationViewModel"
        Title="{Binding WindowTitle}"
        Width="900" Height="700"
        WindowStartupLocation="CenterOwner"
        TransparencyLevelHint="AcrylicBlur"
        Background="Transparent"
        ExtendClientAreaToDecorationsHint="True">

    <Panel>
        <ExperimentalAcrylicBorder IsHitTestVisible="False">
            <ExperimentalAcrylicBorder.Material>
                <ExperimentalAcrylicMaterial
                    BackgroundSource="Digger"
                    TintColor="Black"
                    TintOpacity="1"
                    MaterialOpacity="0.85" />
            </ExperimentalAcrylicBorder.Material>
        </ExperimentalAcrylicBorder>

        <Grid RowDefinitions="Auto, *">
            <!-- Header -->
            <Border Grid.Row="0" Margin="0,30,0,10" Padding="20,0">
                <Grid ColumnDefinitions="Auto, *, Auto">
                    <Button Grid.Column="0" 
                            Command="{Binding BackToSelectionCommand}" 
                            IsVisible="{Binding !IsSelectingType}"
                            Background="Transparent" 
                            BorderThickness="0">
                        <TextBlock Text="← 返回" Foreground="#aaa" FontSize="14"/>
                    </Button>
                    
                    <TextBlock Grid.Column="1" Text="{Binding WindowTitle}" FontSize="20" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                    
                    <!-- Close Button placeholder if needed, or rely on window chrome -->
                </Grid>
            </Border>

            <!-- Type Selection View -->
            <Grid Grid.Row="1" IsVisible="{Binding IsSelectingType}" Margin="40">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Text to Video Card -->
                <Button Grid.Column="0" 
                        Margin="10" 
                        HorizontalAlignment="Stretch" 
                        VerticalAlignment="Stretch"
                        Background="#2d2d2d"
                        CornerRadius="10"
                        Command="{Binding SelectScriptToVideoCommand}">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="20">
                        <TextBlock Text="📝" FontSize="48" HorizontalAlignment="Center"/>
                        <TextBlock Text="文本生成视频" FontSize="20" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                        <TextBlock Text="输入故事脚本，AI 自动生成视频" Foreground="#aaa" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Image to Video Card -->
                <Button Grid.Column="1" 
                        Margin="10" 
                        HorizontalAlignment="Stretch" 
                        VerticalAlignment="Stretch"
                        Background="#2d2d2d"
                        CornerRadius="10"
                        Command="{Binding SelectImageToVideoCommand}">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="20">
                        <TextBlock Text="🖼️" FontSize="48" HorizontalAlignment="Center"/>
                        <TextBlock Text="图片生成视频" FontSize="20" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                        <TextBlock Text="将图片合成为幻灯片视频" Foreground="#aaa" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Configuration View -->
            <ContentControl Grid.Row="1" 
                           Content="{Binding CurrentConfigViewModel}"
                           IsVisible="{Binding !IsSelectingType}"
                           Margin="20">
                <ContentControl.DataTemplates>
                    <!-- Template for ScriptToVideo -->
                    <DataTemplate DataType="{x:Type vm:ScriptToVideoFormViewModel}">
                        <controls:ScriptToVideoControl />
                    </DataTemplate>
                    
                    <!-- Add other templates here optionally -->
                </ContentControl.DataTemplates>
            </ContentControl>
            
        </Grid>
        

    </Panel>
</Window>
