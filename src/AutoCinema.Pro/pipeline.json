{
    "name": "默认视频生产流程",
    "version": "1.0",
    "steps": [
        {
            "name": "StoryboardParsing",
            "displayName": "故事板解析",
            "enabled": true,
            "useCache": true,
            "maxRetries": 3,
            "timeout": 30
        },
        {
            "name": "AssetAggregation",
            "displayName": "素材聚合",
            "enabled": true,
            "useCache": true,
            "maxRetries": 3,
            "timeout": 600
        },
        {
            "name": "SubtitleGeneration",
            "displayName": "字幕生成",
            "enabled": true,
            "useCache": true,
            "maxRetries": 3,
            "timeout": 60
        },
        {
            "name": "VideoComposition",
            "displayName": "视频合成",
            "enabled": true,
            "useCache": false,
            "maxRetries": 2,
            "timeout": 300
        }
    ]
}